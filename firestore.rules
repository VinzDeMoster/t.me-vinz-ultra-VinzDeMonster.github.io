rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function author() {
      return signedIn() && (
        request.auth.uid == "Lt8kkzctunb1lXA1rGxz1xXuYlv2" ||
        (exists(/databases/$(database)/documents/authors/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.get("enabled", false) == true)
      );
    }
    function admin() {
      return signedIn() && !author() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("enabled", false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("isAdmin", false) == true)
      );
    }
    function privileged() { return author() || admin(); }
    function targetAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid)) &&
        get(/databases/$(database)/documents/admins/$(uid)).data.get("enabled", false) == true;
    }
    function suspensionExpired(value) {
      return value == null ||
        (value is timestamp && value <= request.time) ||
        (value is number && value <= request.time.toMillis());
    }
    function activeUser() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("banned", false) != true &&
        suspensionExpired(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("suspendedUntil", null));
    }
    function allowedUser() { return privileged() || activeUser(); }
    function premiumActive() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (u.get("premiumUntil", null) != null) && (
        (u.get("premiumUntil", null) is timestamp && u.get("premiumUntil", null) > request.time) ||
        (u.get("premiumUntil", null) is number && u.get("premiumUntil", null) > request.time.toMillis())
      );
    }
    function forumAvailable(forumId) {
      let f = get(/databases/$(database)/documents/forums/$(forumId)).data;
      return f.get("banned", false) != true && suspensionExpired(f.get("suspendedUntil", null));
    }
    function forumOwner(forumId) {
      return activeUser() && get(/databases/$(database)/documents/forums/$(forumId)).data.ownerId == request.auth.uid;
    }

    match /authors/{uid} {
      allow read: if self(uid) || privileged();
      allow create, update, delete: if author();
    }

    match /users/{uid} {
      allow read: if self(uid) || privileged();
      allow create: if self(uid);
      allow update: if author() ||
        (admin() && uid != request.auth.uid && !targetAdmin(uid) &&
         request.resource.data.username == resource.data.username &&
         request.resource.data.usernameLower == resource.data.usernameLower &&
         request.resource.data.isAdmin == resource.data.isAdmin &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned','suspendedUntil','displayName'])) ||
        (activeUser() && self(uid) &&
         request.resource.data.username == resource.data.username &&
         request.resource.data.usernameLower == resource.data.usernameLower &&
         request.resource.data.isAdmin == resource.data.isAdmin &&
         request.resource.data.banned == resource.data.banned &&
         request.resource.data.suspendedUntil == resource.data.suspendedUntil &&
         request.resource.data.get('premiumPurchases',0) == resource.data.get('premiumPurchases',0) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])) ||
        (admin() && uid != request.auth.uid && !targetAdmin(uid) &&
         request.resource.data.username == resource.data.username &&
         request.resource.data.usernameLower == resource.data.usernameLower &&
         request.resource.data.isAdmin == resource.data.isAdmin &&
         request.resource.data.banned == resource.data.banned &&
         request.resource.data.suspendedUntil == resource.data.suspendedUntil &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premiumUntil','premiumUnlimited','premiumPurchases'])) ||
        (activeUser() && self(uid) &&
         request.resource.data.username == resource.data.username &&
         request.resource.data.usernameLower == resource.data.usernameLower &&
         request.resource.data.isAdmin == resource.data.isAdmin &&
         request.resource.data.banned == resource.data.banned &&
         request.resource.data.suspendedUntil == resource.data.suspendedUntil &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premiumUntil','premiumUnlimited','premiumPurchases','lastActivationCode']) &&
         request.resource.data.lastActivationCode is string &&
         request.resource.data.lastActivationCode.size() == 20 &&
         exists(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)) &&
         get(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)).data.uid == request.auth.uid &&
         get(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)).data.get('used',false) == false &&
         getAfter(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)).data.get('used',false) == true &&
         request.resource.data.premiumUntil == get(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)).data.get('premiumUntil', null) &&
         request.resource.data.premiumUnlimited == get(/databases/$(database)/documents/premiumActivations/$(request.resource.data.lastActivationCode)).data.get('unlimited', false) &&
         request.resource.data.premiumPurchases == resource.data.get('premiumPurchases',0) + 1);
      allow delete: if author() || admin();
    }

    match /admins/{uid} {
      allow read: if privileged() || self(uid);
      allow create, update, delete: if author();
    }

    match /supportRequests/{requestId} {
      allow create: if activeUser() && request.resource.data.uid == request.auth.uid && request.resource.data.username is string && request.resource.data.type is string;
      allow read: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
      allow update, delete: if privileged();
    }

    match /inbox/{messageId} {
      allow read: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
      allow create: if privileged();
      allow update: if privileged() || (activeUser() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
    }

    match /premiumActivations/{code} {
      allow read: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
      allow create: if privileged() && request.resource.id.size() == 20 && request.resource.data.uid is string && request.resource.data.plan is string && request.resource.data.days is int && request.resource.data.days >= 0 && request.resource.data.used == false && request.resource.data.get('unlimited', false) == (request.resource.data.days == 0);
      allow update: if activeUser() && resource.data.uid == request.auth.uid && resource.data.used == false && request.resource.data.used == true && request.resource.data.uid == resource.data.uid;
      allow delete: if privileged();
    }

    match /ads/{adId} {
      allow read: if privileged() || (activeUser() && resource.data.get("active", false) == true);
      allow create: if privileged() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 && request.resource.data.imageUrl is string && request.resource.data.active is bool && request.resource.data.intervalSec is int && request.resource.data.intervalSec >= 50 && request.resource.data.intervalSec <= 36000;
      allow update: if privileged() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100 && request.resource.data.imageUrl is string && request.resource.data.active is bool && request.resource.data.intervalSec is int && request.resource.data.intervalSec >= 50 && request.resource.data.intervalSec <= 36000;
      allow delete: if privileged();
    }

    match /siteSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if privileged() && settingId == "maintenance" && request.resource.data.get("imageUrl", "") is string;
    }

    match /siteSettings/botMenu {
      allow read: if signedIn();
      allow create, update, delete: if privileged() && request.resource.data.get("imageUrl", "") is string;
    }

    match /botLicenses/{code} {
      allow read: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
      allow create: if privileged() &&
        request.resource.id.size() == 20 &&
        request.resource.data.uid is string &&
        request.resource.data.days is int &&
        request.resource.data.maxForums is int &&
        request.resource.data.maxForums >= 20 &&
        request.resource.data.usedForums is list &&
        request.resource.data.usedForums.size() == 0;
      allow update: if privileged() ||
        (activeUser() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.days == resource.data.days &&
         request.resource.data.maxForums == resource.data.maxForums &&
         request.resource.data.usedForums is list &&
         request.resource.data.usedForums.size() == resource.data.usedForums.size() + 1 &&
         request.resource.data.usedForums.hasAll(resource.data.usedForums));
      allow delete: if privileged();
    }

    match /activityLogs/{logId} {
      allow read: if privileged();
      allow create: if allowedUser() && request.resource.data.actorId == request.auth.uid && request.resource.data.message is string && request.resource.data.actorRole is string;
      allow update, delete: if author();
    }

    match /forumCodes/{code} {
      allow read: if signedIn();
      allow create: if allowedUser() && request.resource.data.forumId is string;
      allow update, delete: if privileged();
    }

    match /forums/{forumId} {
      allow read: if privileged() || (activeUser() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.get('memberIds', []) ||
        (exists(/databases/$(database)/documents/forumCodes/$(resource.data.secretCode)) &&
         get(/databases/$(database)/documents/forumCodes/$(resource.data.secretCode)).data.get('forumId','') == forumId)
      ));

      allow create: if allowedUser() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 &&
        request.resource.data.secretCode is string &&
        (privileged() ||
         (request.resource.data.secretCode.size() == 18 && request.resource.data.maxMembers <= 20) ||
         (premiumActive() && request.resource.data.maxMembers <= 400));

      allow update: if privileged() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.secretCode == resource.data.secretCode &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned','suspendedUntil','bannedAt','bannedBy','suspendedAt','suspendedBy','ownerOnly','maxMembers','botCare','profanityFilter']);

      allow update: if forumOwner(forumId) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.maxMembers == resource.data.maxMembers &&
        request.resource.data.secretCode == resource.data.secretCode &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','ownerOnly']) &&
        request.resource.data.memberIds.size() <= resource.data.memberIds.size() &&
        resource.data.memberIds.hasAll(request.resource.data.memberIds);

      allow update: if activeUser() && forumAvailable(forumId) &&
        request.auth.uid in request.resource.data.get('memberIds', []) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.maxMembers == resource.data.maxMembers &&
        request.resource.data.secretCode == resource.data.secretCode &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.memberIds.size() <= resource.data.maxMembers;

      allow update: if forumOwner(forumId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.maxMembers == resource.data.maxMembers &&
        request.resource.data.secretCode == resource.data.secretCode &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['botCare']) &&
        request.resource.data.get('botCare', null) is map &&
        request.resource.data.get('botCare', {}).get('licenseCode', '') is string &&
        request.resource.data.get('botCare', {}).get('licenseCode', '').size() == 20 &&
        exists(/databases/$(database)/documents/botLicenses/$(request.resource.data.get('botCare', {}).get('licenseCode', ''))) &&
        getAfter(/databases/$(database)/documents/botLicenses/$(request.resource.data.get('botCare', {}).get('licenseCode', ''))).data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/botLicenses/$(request.resource.data.get('botCare', {}).get('licenseCode', ''))).data.usedForums.hasAll([forumId]);

      allow delete: if author();

      match /members/{uid} {
        allow read: if privileged() || (activeUser() && forumAvailable(forumId) && (request.auth.uid == uid || forumOwner(forumId)));
        allow create: if allowedUser() && request.auth.uid == uid && request.resource.data.username is string && request.resource.data.displayName is string &&
          getAfter(/databases/$(database)/documents/forums/$(forumId)).data.ownerId is string &&
          request.auth.uid in getAfter(/databases/$(database)/documents/forums/$(forumId)).data.get('memberIds', []);
        allow update: if privileged() || (activeUser() && self(uid));
        allow delete: if privileged() || (forumOwner(forumId) && uid != request.auth.uid) || self(uid);
      }

      match /messages/{messageId} {
        // Privileged roles can always read/write forum messages. Regular users must
        // be active members of an available forum. Keep this rule intentionally
        // simple to avoid permission failures from optional attachment fields.
        allow read: if privileged() || (activeUser() && forumAvailable(forumId) && request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.get('memberIds', []));
        allow create: if allowedUser() &&
          request.resource.data.get('uid','') == request.auth.uid &&
          request.resource.data.get('text','') is string &&
          request.resource.data.get('text','').size() <= 100000 &&
          (request.resource.data.get('text','').size() > 0 || request.resource.data.get('attachment', null) is map) &&
          request.resource.data.get('isAdmin', false) == admin() &&
          request.resource.data.get('isAuthor', false) == author() &&
          request.resource.data.get('premiumPurchases',0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premiumPurchases',0) &&
          (request.resource.data.get('attachment', null) == null || (
            request.resource.data.get('attachment', null) is map &&
            request.resource.data.get('attachment', null).get('name','') is string &&
            request.resource.data.get('attachment', null).get('type','') is string &&
            request.resource.data.get('attachment', null).get('size',0) is int &&
            request.resource.data.get('attachment', null).get('size',0) <= 104857600 &&
            request.resource.data.get('attachment', null).get('url','') is string
          )) &&
          (privileged() || (
            activeUser() && forumAvailable(forumId) &&
            request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.get('memberIds', []) &&
            (get(/databases/$(database)/documents/forums/$(forumId)).data.get('ownerOnly',false) != true || get(/databases/$(database)/documents/forums/$(forumId)).data.ownerId == request.auth.uid)
          ));
        allow update: if privileged() || (activeUser() && resource.data.uid == request.auth.uid);
        allow delete: if privileged() || forumOwner(forumId) || (activeUser() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
