rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid);
      // User sendiri hanya boleh mengubah displayName. Status Premium/Admin/Ban
      // sepenuhnya dikendalikan admin.
      allow update: if admin() || (
        self(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.banned == resource.data.banned &&
        request.resource.data.premiumUntil == resource.data.premiumUntil &&
        request.resource.data.suspendedUntil == resource.data.suspendedUntil
      );
      allow delete: if admin();
    }

    match /admins/{uid} {
      allow read: if admin() || self(uid);
      allow create, update, delete: if admin();
    }

    match /forums/{forumId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.memberIds || admin());
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds.size() == 1 &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.maxMembers >= 2 &&
        request.resource.data.maxMembers <= 20 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.secretCode is string &&
        request.resource.data.secretCode.size() > 0;
      // Hanya admin yang boleh melakukan perubahan umum pada forum.
      // User biasa hanya boleh menambah dirinya sendiri saat join.
      allow update: if admin() || (
        signedIn() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || admin());
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.displayName is string &&
          request.resource.data.username is string &&
          request.resource.data.role in ['owner','member'];
        allow update, delete: if admin() || self(uid);
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.memberIds || admin());
        allow create: if signedIn() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.memberIds;
        allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Permintaan Premium: user boleh membuat dan melihat permintaannya sendiri;
    // admin boleh melihat dan mengelola semua permintaan.
    match /premiumRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update, delete: if admin();
    }
  }
}
