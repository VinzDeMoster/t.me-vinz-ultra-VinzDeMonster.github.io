rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function activeUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true &&
        (!("suspendedUntil" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendedUntil == null ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendedUntil <= request.time);
    }
    function allowedUser() { return admin() || activeUser(); }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid);
      allow update: if admin() || (
        activeUser() && self(uid) &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.usernameLower == resource.data.usernameLower &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.banned == resource.data.banned &&
        request.resource.data.premiumUntil == resource.data.premiumUntil &&
        request.resource.data.suspendedUntil == resource.data.suspendedUntil &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
      );
      allow delete: if admin();
    }

    match /admins/{uid} {
      allow read: if admin() || self(uid);
      allow create, update, delete: if admin();
    }

    match /supportRequests/{requestId} {
      allow create: if activeUser() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.username is string && request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500;
      allow read: if admin();
      allow update: if admin();
      allow delete: if admin();
    }

    match /forumCodes/{code} {
      allow read: if allowedUser();
      allow create: if activeUser() &&
        request.resource.data.forumId is string;
      allow update, delete: if admin();
    }

    match /forums/{forumId} {
      allow read: if admin() || (allowedUser() && (request.auth.uid in resource.data.memberIds || get(/databases/$(database)/documents/forumCodes/$(resource.data.secretCode)).data.forumId == forumId));
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if admin() ||
        (activeUser() && resource.data.ownerId == request.auth.uid) ||
        (activeUser() && (request.auth.uid in resource.data.memberIds ||
          (request.auth.uid in request.resource.data.memberIds &&
           get(/databases/$(database)/documents/forumCodes/$(resource.data.secretCode)).data.forumId == forumId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.maxMembers == resource.data.maxMembers &&
          request.resource.data.secretCode == resource.data.secretCode &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.auth.uid in request.resource.data.memberIds);
      allow delete: if admin() || (activeUser() && resource.data.ownerId == request.auth.uid);

      match /members/{uid} {
        allow read: if allowedUser() && (request.auth.uid == uid || admin());
        allow create: if activeUser() && request.auth.uid == uid &&
          request.resource.data.username is string && request.resource.data.displayName is string;
        allow update, delete: if admin() || (activeUser() && self(uid));
      }

      match /messages/{messageId} {
        allow read: if allowedUser() && (request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.memberIds || admin());
        allow create: if activeUser() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.isAdmin == admin() &&
          ((!("premiumPurchases" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) && request.resource.data.premiumPurchases == 0) ||
           request.resource.data.premiumPurchases == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premiumPurchases) &&
          (admin() || request.auth.uid in get(/databases/$(database)/documents/forums/$(forumId)).data.memberIds);
        allow update, delete: if admin() || (activeUser() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
